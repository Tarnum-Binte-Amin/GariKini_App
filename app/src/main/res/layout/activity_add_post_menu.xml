<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addPostToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#009688"
        app:title="Add Post"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Urgent Banner Button -->
            <Button
                android:id="@+id/btnTopUrgentBanner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Top Urgent Post"
                android:drawableStart="@android:drawable/ic_menu_recent_history"
                android:drawableTint="#009688"
                android:backgroundTint="#B2DFDB"
                android:textColor="#009688"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp"/>

            <!-- Category Cards Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <!-- 1. Light Vehicles -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLightVehicle"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/light_vehicle"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Light Vehicles"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 2. Heavy Vehicles -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHeavyVehicle"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/heavy_vehicle"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heavy Vehicles"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 3. Bus -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBus"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bus"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bus"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 4. Truck -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTruck"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/truck"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Truck"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 5. Heavy & Equipment Vehicles -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHeavyEquipment"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/heavy_equipment"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heavy &amp; Equipment"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 6. Motorbike -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMotorbike"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/motorbike"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Motorbike"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 7. Bicycle -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBicycle"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bicycle"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bicycle"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 8. Auto CNG -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAutoCng"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/auto_cng"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto CNG"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 9. Paddle Rickshaw -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPaddleRickshaw"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/paddle_rickshaw"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paddle Rickshaw"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 10. Paddle Van -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPaddleVan"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/paddle_van"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paddle Van"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 11. Three Wheeler -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardThreeWheeler"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/three_wheeler"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Three Wheeler"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 12. Auto Service Center -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAutoService"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EFEFEF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:background="@drawable/auto_service_center"
                            app:tint="#009688"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto Service Center"
                            android:textStyle="bold"
                            android:textColor="#212121"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>